# Appwrite Configuration
NEXT_PUBLIC_APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
NEXT_PUBLIC_APPWRITE_PROJECT_ID="your_project_id"
NEXT_PUBLIC_APPWRITE_PROJECT_NAME="Lumina"
NEXT_PUBLIC_APPWRITE_KEY="your_secret_api_key"
NEXT_PUBLIC_APPWRITE_DATABASE="your_database_id"
NEXT_PUBLIC_APPWRITE_USERS_COLLECTION="users"
NEXT_PUBLIC_APPWRITE_FILES_COLLECTION="files"
NEXT_PUBLIC_APPWRITE_BUCKET="your_bucket_id"

# Google Gemini API (Vercel AI SDK - Server-side only)
GOOGLE_GENERATIVE_AI_API_KEY="your_gemini_api_key"
# Optional: override the default Gemini model (defaults to gemini-2.5-flash)
# GEMINI_MODEL="gemini-2.5-flash"

# Groq API (High-speed inference for Llama / GPT-OSS models)
GROQ_API_KEY="your_groq_api_key"
